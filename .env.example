# --- Database (Supabase Postgres) -------------------------------------------
# On Vercel, the Supabase integration sets POSTGRES_URL automatically.
# Locally, paste Supabase → Project Settings → Database → Connection string (URI).
# If DATABASE_URL and POSTGRES_URL are both unset, dev mode stores signups in .data/dev-store.json
DATABASE_URL=
# Tables are created automatically on first request; `npm run db:migrate` also works.

# Public site URL for referral links and social cards (optional on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Token to open /admin?token=...  (use a long random string)
ADMIN_TOKEN=
# Salt for hashing IP addresses (never store raw IPs)
IP_HASH_SALT=

# --- Welcome email from binwala@perfstaq.com --------------------------------
MAIL_FROM="Binwala <binwala@perfstaq.com>"
# Option A: Resend (verify perfstaq.com at resend.com/domains, then paste the API key)
RESEND_API_KEY=
# Option B: the binwala@perfstaq.com mailbox over SMTP (use an app password)
#   Google Workspace: smtp.gmail.com 465 · Zoho: smtp.zoho.in 465 · Hostinger: smtp.hostinger.com 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=binwala@perfstaq.com
SMTP_PASS=
# Optional: get an alert for every signup
MAIL_NOTIFY_TO=binwala@perfstaq.com

# --- Address search (optional) ---------------------------------------------
# Without a key, building search uses OpenStreetMap. With a Google key (Places API (New) +
# Geocoding API enabled) apartment and society names are much more complete.
GOOGLE_MAPS_API_KEY=
